generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}





model User {
  id              String      @id @default(cuid())
  name            String?   // display name - the Auth.js adapter sets this for Google sign-ins
  firstName       String?
  lastName        String?
  email           String      @unique
  emailVerified   DateTime?
  image           String?   // set by the Google adapter on social sign-in
  avatarKey       String?   // her own uploaded profile picture (private R2 key)
  passwordHash    String?   // null for Google-only users
  role            Role        @default(CLIENT)
  plan            String?   // the tier name, e.g. "Strong Girl Project"
  goal            String?   // coaching fields (set by the coach on the client)
  program         String?

  // --- Intake, captured on the onboarding call (all optional) ---
  dateOfBirth DateTime?  // stored rather than age, so it never goes stale
  lifestyle   String?    // free text: work, family, training history
  injuries    String?    // injuries / limitations - surfaced while programming
  status          String      @default("active") // "active" | "paused"

  // --- Billing (Stripe) ---
  stripeCustomerId   String?  @unique            // set the first time they start checkout
  subscriptionStatus String?                     // mirror of the Stripe subscription: "active" | "past_due" | "canceled" | ...
  billingExempt      Boolean  @default(false)    // grandfathered/comped clients skip payment entirely

  // --- Strong Girl Project (one-off 6-week programme) ---
  programmePaidAt       DateTime?                  // when the one-off payment landed; null = never bought
  programmeEndEmailSent Boolean   @default(false)  // the "your programme has ended" email went out
  groupId               String?                    // FK -> Group.id, set when Millie places them in a group
  group                 Group?    @relation(fields: [groupId], references: [id], onDelete: SetNull)
  groupChatSeenAt       DateTime?                  // last time they opened the group chat (unread badge)
  groupMessages         GroupMessage[] @relation("GroupMessages")

  createdAt       DateTime    @default(now())
  accounts        Account[]
  sessions        Session[]
  unit            String      @default("kg")  // "kg" | "lb" - weight unit preference
  workouts        Workout[]                  // sessions where this user is the client
  selfWorkouts    SelfWorkout[]              // sessions they logged on their own
  coachNotes      CoachNote[]                // private coach notes about this client
  templates       Template[]                 // templates this user (coach) owns
  messages        Message[]                  // this client's message thread
  notifications   Notification[]
  notifyMessages  Boolean     @default(true)
  notifySummary   Boolean     @default(true)
  notifyReminders Boolean     @default(false)

  // --- Nutrition --- (tier is derived from `plan`, not stored)
  nutritionProfile  NutritionProfile?
  nutritionLogs     NutritionLog[]
  nutritionInsights NutritionInsight[]

  // --- Cycle tracking (opt-in) ---
  cycleProfile      CycleProfile?
  cycleLogs         CycleLog[]
  announcements     Announcement[] @relation("ClientAnnouncements")

  notifyForms     Boolean          @default(true) // email me when a form is assigned
  forms           Form[]           @relation("CoachForms")
  formAssignments FormAssignment[] @relation("ClientAssignments")
  formRecurrences FormRecurrence[] @relation("ClientRecurrences")
}

// A Strong Girl Project cohort: everyone starts together and the 6-week
// programme window (start -> start + 42 days) is derived from startDate.
// The cap of 12 is enforced by the coach, not the database.
model Group {
  id           String         @id @default(cuid())
  name         String
  startDate    DateTime       // programme day 1; access ends after day 42
  callSchedule String?        // e.g. "Wednesdays 7pm" - shown on My Group
  callLink     String?        // Zoom/Meet link for the weekly call
  createdAt    DateTime       @default(now())
  members      User[]
  messages     GroupMessage[]
  lessons      GroupLesson[]
  announcements Announcement[]
}

// One message in a group's chat (text only; Millie can delete any).
model GroupMessage {
  id        String   @id @default(cuid())
  groupId   String
  senderId  String
  text      String
  createdAt DateTime @default(now())

  group  Group @relation(fields: [groupId], references: [id], onDelete: Cascade)
  sender User  @relation("GroupMessages", fields: [senderId], references: [id], onDelete: Cascade)

  @@index([groupId, createdAt])
}

// A weekly mini lesson Millie posts to a group (title + notes + optional link).
model GroupLesson {
  id        String   @id @default(cuid())
  groupId   String
  title     String
  notes     String
  link      String?
  createdAt DateTime @default(now())

  group Group @relation(fields: [groupId], references: [id], onDelete: Cascade)

  @@index([groupId, createdAt])
}

enum Role {
  COACH
  CLIENT
}

model Invite {
  id         String       @id @default(cuid())
  email      String
  firstName  String?
  lastName   String?
  plan       String
  token      String       @unique
  status     InviteStatus @default(PENDING)
  createdAt  DateTime     @default(now())
  expiresAt  DateTime
  acceptedAt DateTime?

  // --- What Millie learns on the onboarding call, copied onto the User when
  // the invite is accepted. All optional: an invite can go out before the call.
  dateOfBirth DateTime?
  lifestyle   String?
  injuries    String?
  goal        String?

  // Cycle tracking arranged on the call. When cycleTracking is true a
  // CycleProfile is created at signup, so she only has to consent.
  cycleTracking   Boolean @default(false)
  contraception   String?
  avgCycleLength  Int?
  avgPeriodLength Int?
}

enum InviteStatus {
  PENDING
  ACCEPTED
  REVOKED
}

// --- Standard Auth.js tables ---
model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?
  user              User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime
  @@unique([identifier, token])
}

// --- Exercise Library ---

model Exercise {
  id            String   @id @default(cuid())
  name          String
  category      String
  cue           String?
  guideImageUrl String?
  createdAt     DateTime @default(now())

  workoutExercises  WorkoutExercise[]
  templateExercises TemplateExercise[]
}

// -- workout ---

model Workout {
  id          String    @id @default(cuid())
  clientId    String
  date        String
  title       String
  focus       String
  status      String    @default("assigned")  //  "assigned" | "completed" | in_progress
  warmup      String?   // free-text warmup note for the session
  createdAt   DateTime  @default(now())

  client     User      @relation(fields: [clientId], references: [id], onDelete: Cascade)
  exercises  WorkoutExercise[]
  checkIn    CheckIn?

  @@unique([clientId, date])
}

model WorkoutExercise {
  id          String   @id @default(cuid())
  workoutId   String
  exerciseId  String
  order       Int     @default(0)
  prescription String  @default("")
  note        String?
  groupId     String?  // exercises sharing a groupId form one superset/circuit
  groupType   String?  // "superset" | "circuit" (null = standalone)
  optedOut    Boolean @default(false)  // client couldn't/wouldn't do this exercise
  optOutNote  String?                  // their reason, shown to the coach

  workout   Workout  @relation(fields: [workoutId], references: [id], onDelete: Cascade)
  exercise  Exercise @relation(fields: [exerciseId], references: [id], onDelete: Cascade)
  sets      WorkoutSet[]

  @@index([workoutId])
}

model WorkoutSet {
  id                 String   @id @default(cuid())
  workoutExerciseId  String
  order              Int     @default(0)
  targetReps         Int     @default(0)   // 0 / ignored for cardio intervals
  targetRpe          String?  // coach's prescribed RPE, e.g. "7-8" (replaces target weight)

  // --- Cardio interval prescription (null for strength sets) ---
  workSeconds        Int?     // "on" duration in seconds
  restSeconds        Int?     // "off" duration in seconds
  pace               String?  // target pace, free text e.g. "9 km/h", "5:00/km"

  loggedReps         Int?
  loggedWeight       Float?   // the client still logs the actual weight they lifted

  // --- Cardio actuals logged by the client (null for strength sets) ---
  loggedDistance     Float?   // actual distance covered in the interval
  loggedPace         String?  // actual pace, free text

  completed          Boolean @default(false)

  workoutExercise    WorkoutExercise @relation(fields: [workoutExerciseId], references: [id], onDelete: Cascade)

  @@index([workoutExerciseId])
}

// A session the client did on their own (outside their programming). Just a
// description for now, so the coach knows - lives in its own table so it can
// coexist with an assigned Workout on the same date.
model SelfWorkout {
  id          String   @id @default(cuid())
  clientId    String
  date        String                     // "YYYY-MM-DD", same convention as Workout.date
  description String
  createdAt   DateTime @default(now())

  client User @relation(fields: [clientId], references: [id], onDelete: Cascade)

  @@index([clientId, date])
}

// Private, coach-only notes about a client (a lightweight CRM). Never shown to
// the client.
model CoachNote {
  id        String   @id @default(cuid())
  clientId  String
  text      String
  pinned    Boolean  @default(false)
  createdAt DateTime @default(now())

  client User @relation(fields: [clientId], references: [id], onDelete: Cascade)

  @@index([clientId, createdAt])
}

model CheckIn {
  id          String   @id @default(cuid())
  workoutId   String   @unique
  // Two moments: how she felt starting (with her cycle phase), and how she
  // felt afterwards. Either can exist without the other.
  energyBefore Int?
  energy      Int?     // "how do you feel now" - logged at the end
  cyclePhase  String   @default("none")  // captured before the session
  note        String?
  createdAt   DateTime @default(now())

  workout     Workout  @relation(fields: [workoutId], references: [id], onDelete: Cascade)
}


// --- Reusable program template ---

model Template {
  id          String        @id @default(cuid())
  coachId     String?
  name        String
  description String?
  createdAt   DateTime      @default(now())

  coach      User? @relation(fields: [coachId], references: [id], onDelete: SetNull)
  days      TemplateDay[]
}

model TemplateDay {
  id         String             @id @default(cuid())
  templateId String                            // FK → Template.id
  dow        Int                               // 0=Mon … 6=Sun
  title      String
  focus      String
  warmup     String?                           // free-text warmup note

  template  Template           @relation(fields: [templateId], references: [id], onDelete: Cascade)
  exercises TemplateExercise[]

  @@index([templateId])
}

model TemplateExercise {
  id            String  @id @default(cuid())
  templateDayId String                          // FK → TemplateDay.id
  exerciseId    String                          // FK → Exercise.id
  order         Int     @default(0)
  prescription  String  @default("")
  note          String?                         // coaching note (parity with WorkoutExercise)
  groupKey      String?                         // relative group key within the day
  groupType     String?                         // "superset" | "circuit"

  templateDay TemplateDay  @relation(fields: [templateDayId], references: [id], onDelete: Cascade)
  exercise    Exercise     @relation(fields: [exerciseId], references: [id], onDelete: Cascade)
  sets        TemplateSet[]                     // individual sets (parity with WorkoutSet)

  @@index([templateDayId])
}

model TemplateSet {
  id                 String  @id @default(cuid())
  templateExerciseId String
  order              Int     @default(0)
  targetReps         Int     @default(10)
  targetRpe          String?                     // e.g. "7-8"

  // --- Cardio interval prescription (null for strength sets) ---
  workSeconds        Int?                         // "on" duration in seconds
  restSeconds        Int?                         // "off" duration in seconds
  pace               String?                      // target pace, free text

  templateExercise   TemplateExercise @relation(fields: [templateExerciseId], references: [id], onDelete: Cascade)

  @@index([templateExerciseId])
}

// --- Messages ---

model Message {
  id          String   @id @default(cuid())
  clientId    String                            // FK → User.id (whose thread)
  senderRole  String                            // "coach" | "client"
  text        String   @default("")             // can be empty for a video-only message
  videoKey    String?                           // R2 object key for an attached video
  verdict     String?                           // coach's verdict on a video: "good" | "needs_work"
  verdictNote String?                           // optional note alongside the verdict
  read        Boolean  @default(false)          // read by the recipient
  createdAt   DateTime @default(now())

  client User @relation(fields: [clientId], references: [id], onDelete: Cascade)

  @@index([clientId, createdAt])
}

// --- Notifications ---
model Notification {
  id           String         @id @default(cuid())
  userId       String
  type         String
  title        String
  link         String?
  read         Boolean        @default(false)
  createdAt    DateTime       @default(now())
  user         User           @relation(fields: [userId], references: [id], onDelete: Cascade)

}

// --- App-wide key/value settings (coach-controlled toggles) ---
model AppSetting {
  key   String @id
  value String
}

// --- Broadcast announcements (coach -> everyone, a group, or one client) ---
// Carries an optional recorded voice note: Millie's weekly "well done, keep
// going" without her having to type it.
model Announcement {
  id        String   @id @default(cuid())
  message   String
  showUntil DateTime // the in-portal banner shows until this date
  createdAt DateTime @default(now())

  // Voice note (stored privately in R2, played via a short-lived signed URL)
  audioKey     String?
  audioSeconds Int?

  // Audience: clientId wins, then groupId, then everyone.
  groupId  String?
  clientId String?
  group    Group? @relation(fields: [groupId], references: [id], onDelete: Cascade)
  client   User?  @relation("ClientAnnouncements", fields: [clientId], references: [id], onDelete: Cascade)

  @@index([showUntil])
}

// --- Nutrition ---

// Goals + settings for one client (1:1 with User).
model NutritionProfile {
  id                String   @id @default(cuid())
  userId            String   @unique
  bodyWeightKg      Float?                       // null until they enter it
  proteinMultiplier Float    @default(1.6)       // g per kg
  stepsGoal         Int      @default(10000)
  sleepGoal         Float    @default(8)
  waterGoal         Float    @default(2.5)
  fiveADayGoal      Int      @default(5)
  updatedAt         DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

// One row per client per day - what they actually logged.
model NutritionLog {
  id        String   @id @default(cuid())
  userId    String
  date      String                               // "YYYY-MM-DD", same convention as Workout.date
  protein   Int      @default(0)                  // grams
  steps     Int      @default(0)
  sleep     Float    @default(0)                  // hours
  water     Float    @default(0)                  // litres
  fiveADay  Int      @default(0)                  // portions
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, date]) // one log per person per day
  @@index([userId, date])
}

// Coach-curated meal & snack database (shared library; clients see tier-gated fields).
model Meal {
  id          String   @id @default(cuid())
  name        String
  category    String                            // "Breakfast" | "Lunch" | "Dinner" | "Snack"
  description String   @default("")
  recipe      String[]                          // ordered steps
  price       Float    @default(0)              // £ per serving
  protein     Int      @default(0)
  carbs       Int      @default(0)
  fat         Int      @default(0)
  calories    Int      @default(0)
  budget      Boolean  @default(false)
  education   String?                           // shown Beginner+
  coachNote   String?                           // shown Performance
  createdAt   DateTime @default(now())
}

// Coach-authored insight notes for one client (shown on the Performance tier).
model NutritionInsight {
  id        String   @id @default(cuid())
  clientId  String
  text      String
  createdAt DateTime @default(now())

  client User @relation(fields: [clientId], references: [id], onDelete: Cascade)

  @@index([clientId])
}

model Form {
  id          String   @id @default(cuid())
  coachId     String?
  title       String
  description String?
  questions   Json     // FormQuestion[] from lib/forms/types.ts
  createdAt   DateTime @default(now())

  coach       User?            @relation("CoachForms", fields: [coachId], references: [id], onDelete: SetNull)
  assignments FormAssignment[]
  recurrences FormRecurrence[]
}

model FormAssignment {
  id          String    @id @default(cuid())
  formId      String
  clientId    String
  status      String    @default("assigned") // "assigned" | "completed"
  dueDate     String?                          // "YYYY-MM-DD"
  answers     Json?                            // FormAnswer[] - filled on submit
  assignedAt  DateTime  @default(now())
  completedAt DateTime?

  form   Form @relation(fields: [formId], references: [id], onDelete: Cascade)
  client User @relation("ClientAssignments", fields: [clientId], references: [id], onDelete: Cascade)

  @@index([clientId])
  @@index([formId])
}

model FormRecurrence {
  id        String   @id @default(cuid())
  formId    String
  clientId  String
  cadence   String   // "weekly" | "monthly"
  active    Boolean  @default(true)
  lastRun   String?  // "YYYY-MM-DD" of the last auto-assignment
  createdAt DateTime @default(now())

  form   Form @relation(fields: [formId], references: [id], onDelete: Cascade)
  client User @relation("ClientRecurrences", fields: [clientId], references: [id], onDelete: Cascade)

  @@index([clientId])
}
// --- Cycle tracking (opt-in, special-category health data) ---
// Millie configures a client's profile; the client consents before anything is
// stored. Phase predictions only run for contraception that doesn't suppress
// or mask ovulation - see lib/cycle.ts.
model CycleProfile {
  id              String    @id @default(cuid())
  userId          String    @unique
  contraception   String    @default("none")  // see CONTRACEPTION in lib/cycle.ts
  avgCycleLength  Int       @default(28)
  avgPeriodLength Int       @default(5)
  shareLevel      String    @default("minimal") // "minimal" = phase + energy | "full" = + symptoms/notes
  setupByCoachAt  DateTime?                     // null = Millie hasn't set them up yet
  consentAt       DateTime?                     // null = the client hasn't opted in yet
  createdAt       DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

// One row per logged day. A "period" is a run of consecutive days with flow.
model CycleLog {
  id           String   @id @default(cuid())
  userId       String
  date         String                      // YYYY-MM-DD (UTC), same convention as Workout.date
  flow         String?                     // "light" | "medium" | "heavy" | null = no bleed
  symptoms     String[] @default([])       // see SYMPTOMS in lib/cycle.ts
  mood         Int?                        // 1-5
  sleepQuality Int?                        // 1-5
  note         String?
  createdAt    DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, date])
  @@index([userId, date])
}

// Millie's own words on training in each phase - written in Settings, shown to
// the client on her cycle page and as she starts a session.
model CycleGuidance {
  phase     String   @id            // "menstrual" | "follicular" | "ovulation" | "luteal"
  training  String
  updatedAt DateTime @updatedAt
}
